# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Two database roles, deliberately:
#   DATABASE_DIRECT_URL  the owner. Migrations only. Carries BYPASSRLS on Neon,
#                        which skips row-level security entirely -- never run the
#                        application with it.
#   DATABASE_APP_URL     the runtime role. NOBYPASSRLS, created by
#                        scripts/create-app-role.ts, which writes this line for you.
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_APP_ROLE=app_user
DATABASE_APP_URL=

# Collection. Every one of these is optional; a source whose secret is missing is
# skipped rather than failing.
USER_AGENT=NewsTrack/0.1 (+https://your-domain.example/about)
FETCH_TIMEOUT_MS=15000
POLITENESS_INTERVAL_MS=2000
SOURCE_FAILURE_THRESHOLD=10
GITHUB_TOKEN=
NVD_API_KEY=
PRODUCTHUNT_TOKEN=

# Content gates
MIN_CONTENT_CHARS_LATIN=400
MIN_CONTENT_CHARS_CJK=150
ALLOWED_LANGUAGES=en
DROP_ENCLOSURE_TYPES=audio/*,video/*
DROP_FEED_IF_ENCLOSURE_RATIO_ABOVE=0.5
BLOCKED_HOSTS=youtube.com,youtu.be,vimeo.com,twitch.tv,open.spotify.com

# Model routing. Free tiers do triage; Claude does anything a user reads.
# Verify model ids against each provider's /models endpoint before trusting them --
# open-weight models are retired without notice.
GROQ_API_KEY=
GROQ_MODEL_CLASSIFY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL_CLASSIFY=gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL_CLASSIFY=gemini-3.5-flash-lite
GEMINI_MODEL_TRANSLATE=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_JUDGMENT=claude-opus-5
IMPORTANCE_ESCALATION_THRESHOLD=6

# Dedup. SIMHASH_HAMMING_THRESHOLD is the auto-merge line; DEDUP_AMBIGUOUS_LOWER
# is a similarity ratio setting the outer edge of the band that reaches a model.
SIMHASH_HAMMING_THRESHOLD=3
DEDUP_AMBIGUOUS_LOWER=0.75
BATCH_SIZE_CLASSIFY=20
BATCH_SIZE_DEDUP_PAIRS=10

# Quality sampling is mandatory: degradation is silent.
QUALITY_SAMPLE_SIZE=20
QUALITY_AGREEMENT_THRESHOLD=0.90

# Snapshot offsets cannot be reconstructed after the fact.
SNAPSHOT_OFFSETS_HOURS=1,6,24,168

# Phase 1 gate: keep both false for one full week of pure collection.
CLASSIFICATION_ENABLED=false
DELIVERY_ENABLED=false

APP_URL=http://localhost:3000

# --- Running it -------------------------------------------------------------
#
# `npm start` is the whole system: the web server and the scheduler that
# collects, tags, processes, rolls up and prunes. Everything below has a default
# that works, so an empty section here is a working deployment.
#
# ROLE       all | web | worker. One process does both halves, which is the
#            cheapest arrangement and the right default. Split them when you
#            want several web containers behind a load balancer -- the scheduler
#            takes a claim on each job, so even two workers divide the work
#            rather than duplicating it.
ROLE=all
#
# HOST       Loopback unless you say otherwise. A container has to bind 0.0.0.0
#            or its platform's health check never reaches it; the default is
#            127.0.0.1 because binding every interface by accident is how a
#            development server ends up on the internet.
HOST=127.0.0.1
PORT=3000
#
# ADMIN_TOKEN  REQUIRED IF HOST IS PUBLIC. /admin runs on the database owner
#            connection, which bypasses row-level security. On a public bind it
#            serves nothing at all without this, and then only to a request
#            carrying it as the x-admin-token header or ?token=. Generate with
#            `openssl rand -hex 32`.
ADMIN_TOKEN=
#
# PROCESSING_ENABLED  "0" leaves collection, tagging and retention running and
#            turns off the part that costs model calls -- dedup, classification
#            and scoring. Stories still arrive and are still readable.
PROCESSING_ENABLED=1
#
# SCHEDULER_TICK_SECONDS   how often to LOOK for due work, not how often jobs
#            run. Each job's own cadence is in src/run/jobs.ts.
# SCHEDULER_MAX_PARALLEL   most jobs running at once.
# COLLECT_BATCH            sources per collection cycle.
# COLLECT_CONCURRENCY      feeds fetched at once; blank follows FETCH_MAX_CONCURRENCY.
SCHEDULER_TICK_SECONDS=5
SCHEDULER_MAX_PARALLEL=3
COLLECT_BATCH=40
COLLECT_CONCURRENCY=

# --- Vocabulary sources -------------------------------------------------------
# All optional and all free. Without them the imports still run, just smaller:
# every one of these raises a ceiling rather than enabling a feature.
#
# STACKEXCHANGE_KEY  all 5,329 tag synonyms instead of the 2,500 most-applied.
#                    Page 26 returns access_denied without it, whatever the
#                    daily quota says.
#                    Register at https://stackapps.com/apps/oauth/register and
#                    use the "key" field -- no OAuth flow is needed.
STACKEXCHANGE_KEY=
#
# LIBRARIES_IO_KEY   packages across 30-odd registries ranked by how many
#                    repositories depend on them. Skipped entirely without it.
#                    Key is on https://libraries.io/account
LIBRARIES_IO_KEY=
